# Sparkline server environment variables
# Copy to .env or export in your shell. All values are optional.

# HTTP port the server listens on
PORT=3000

# Host to bind
HOST=0.0.0.0

# Public URL of the deployment (used for share links / QR payloads / absolute file URLs)
PUBLIC_URL=http://localhost:3000

# Database & storage locations
DB_PATH=./data/sparkline.db
UPLOAD_DIR=./data/uploads

# Client build directory to serve in production (for local builds: ../client/dist)
CLIENT_DIR=../client/dist

# Session lifetime in days
SESSION_TTL_DAYS=90

# Admin access key. If empty, a random key is generated and printed at startup.
ADMIN_KEY=

# WebRTC

# Public STUN servers (comma separated)
STUN_URLS=stun:stun.l.google.com:19302

# Optional TURN server (static credentials).
# Without a TURN server, calls may fail behind strict NATs — deploy one for production.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional GIPHY API key (beta access key works for local dev).
# When absent, GIF search is disabled in the UI.
GIPHY_API_KEY=

# Abuse protection knobs
RATE_MSG_MAX=30
RATE_MSG_WINDOW=10000
RATE_CONNECT_MAX=10
RATE_CONNECT_WINDOW=3600000

# Upload limits (bytes)
MAX_UPLOAD_IMAGE=15728640
MAX_UPLOAD_VIDEO=209715200
MAX_UPLOAD_AUDIO=26214400
MAX_UPLOAD_DOC=104857600

# Log level: debug | info | warn | error
LOG_LEVEL=info